<%
  const count = (theme.post && theme.post.related_count) || 4;
  const related = xfm_related(page, count);
  const fallback = (site.posts.data || [])
    .filter(function (p) { return p.path !== page.path; })
    .sort(function (a, b) { return new Date(b.date) - new Date(a.date); })
    .slice(0, count);
  const list = related.length ? related : fallback;
%><% if (list.length) { %>
<section class="post-related">
  <div class="section-head">
    <svg class="xfm-icon" aria-hidden="true"><use xlink:href="#xfm-i-star"></use></svg>
    <h3><%= __('post.related') %></h3>
  </div>
  <div class="related-grid">
    <% list.forEach(function (p) {
         const cover = xfm_cover(p);
    %>
    <a class="related-card" href="<%= url_for(p.path) %>">
      <span class="related-cover">
        <% if (cover) { %><img src="<%= cover %>" alt="<%= p.title %>" loading="lazy"><% } else { %>
        <svg class="xfm-icon" aria-hidden="true"><use xlink:href="#xfm-i-note"></use></svg><% } %>
      </span>
      <span class="related-info">
        <span class="related-title"><%= p.title %></span>
        <span class="related-date"><%= date(p.date, 'MM-DD') %> · <%= xfm_reading(p.content) %> <%= __('post.min_read') %></span>
      </span>
    </a>
    <% }); %>
  </div>
</section><% } %>
