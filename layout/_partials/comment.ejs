<%
  const enabled = theme.comments && theme.comments.enable && page.comments !== false;
  const type = theme.comments && theme.comments.type ? theme.comments.type : 'giscus';
  const conf = (theme.comments && theme.comments[type]) || {};

  // 键名归一：Waline v2 只认驼峰选项（serverURL / requiredMeta / pageSize…），
  // 直接透传 server_url 会被静默忽略、评论区加载不出来。已写成驼峰的保持原样。
  const camelize = function (key) {
    return String(key).replace(/_([a-z0-9])/g, function (_, c) { return c.toUpperCase(); });
  };
  const CAMEL_ALIAS = { serverUrl: 'serverURL' };
  const normalizeKey = function (key) {
    if (type !== 'waline' || String(key).indexOf('_') === -1) return key;
    const camel = camelize(key);
    return CAMEL_ALIAS[camel] || camel;
  };

  let payload = { type: type, opts: {} };
  Object.keys(conf).forEach(function (k) {
    const v = conf[k];
    const key = normalizeKey(k);
    if (Array.isArray(v)) payload.opts[key] = v;
    else if (v !== null && v !== undefined && v !== '') payload.opts[key] = v;
  });
  payload.scheme = (theme.appearance && theme.appearance.scheme) || 'auto';
  payload.lang = config.language || 'zh-CN';
  payload.lazyload = theme.comments && theme.comments.lazyload !== false;
%>
<% if (enabled) { %>
<section class="comments-area" id="comments">
  <div class="section-head">
    <svg class="xfm-icon" aria-hidden="true"><use xlink:href="#xfm-i-note"></use></svg>
    <h3><%= (theme.comments && theme.comments.title) || __('comments.title') %></h3>
  </div>
  <div class="comments-body" id="xfm-comments" data-comment-config="<%= JSON.stringify(payload) %>">
    <div class="comment-placeholder">
      <svg class="xfm-icon spin" aria-hidden="true"><use xlink:href="#xfm-i-loader"></use></svg>
      <span><%= __('comments.loading') %></span>
    </div>
  </div>
</section>
<% } %>
