<%
  const social = theme.social || {};
  const socialClass = (typeof extraClass !== 'undefined' && extraClass) || '';
  // RSS 社交入口与导航栏 / 页脚 / head 自动发现共用一份判定：
  // 没装 feed 生成器（且未强制开启）时不输出，避免指向不存在订阅源的空链接。
  const rssOn = xfm_rss().enable;
  const keys = Object.keys(social).filter(function (k) {
    if (!social[k]) return false;
    if (k === 'rss' && !rssOn) return false;
    return true;
  });
%><% if (keys.length) { %>
<div class="social-links <%= socialClass %>">
  <% keys.forEach(function (name) {
       const url = social[name];
       const target = /^https?:\/\//i.test(String(url)) ? ' target="_blank" rel="noopener noreferrer"' : '';
  %>
  <a class="social-item social-<%= name %>" href="<%= url %>"<%= target %> aria-label="<%= name %>" title="<%= name %>">
    <svg class="xfm-icon" aria-hidden="true"><use xlink:href="#xfm-i-<%= name %>"></use></svg>
  </a>
  <% }); %>
</div><% } %>
